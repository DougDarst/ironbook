# Copy to `.env` for local development. Never commit `.env`.

# URL of the PocketBase server the frontend talks to during `npm run dev` only.
# Builds ignore it: the built app is served by PocketBase and always uses the
# same origin.
VITE_PB_URL=http://127.0.0.1:8092

# Deployment (scripts/deploy.sh). Only needed on the machine you deploy from.
# SSH login for the server, as used by `ssh` and `rsync`.
DEPLOY_HOST=you@your-server
# App folder on the server (holds the binary, pb_data, pb_public, ...).
DEPLOY_PATH=/opt/ironbook
# systemd service name and the local port PocketBase listens on.
DEPLOY_SERVICE=ironbook
DEPLOY_PORT=8092
