{
  "name": "ironbook",
  "version": "0.0.0",
  "private": true,
  "description": "A weightlifting logbook: log sets, track volume over time. PocketBase + Svelte.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "pb:setup": "./scripts/setup-pocketbase.sh",
    "pb:serve": "./pocketbase serve --http 127.0.0.1:8092",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run check && npm run test && npm run test:integration && npm run test:e2e",
    "deploy": "./scripts/deploy.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lucide/svelte": "^1.72.0",
    "pocketbase": "^0.28.2"
  }
}
